#: contests/templates/backtrack.html:7 contests/templates/base.html:96
msgctxt "backtrack"
msgid "Backtrack"
msgstr "پچھلیاں ترمیماں"

#: contests/templates/backtrack.html:15
msgctxt "backtrack-about"
msgid ""
"This page lists the edits participats did in the context of the wikicontest "
"but were made before their registration in the Outreach Dashboard. If "
"necessary, click on the button to accept the edit. After acceptance, the "
"edit will be available in the evaluation queue."
msgstr ""
"ایندا صفحے تے او ترمیماں درج ہن جیہڑیاں شرکا وکی مقابلے دے تناظر وچ کیتیاں، "
"پر آؤٹ ریچ ڈیش بورڈ وچ انہاں دے اندراج توں پہلے کیتیاں ڳئیاں ہن۔ جے ضرورت "
"ہووے تاں ترمیم قبول کرݨ واسطے بٹݨ تے کلک کرو۔ قبولیت دے بعد، ترمیم جائزے دی "
"قطار وچ دستیاب تھی ویسی۔"

